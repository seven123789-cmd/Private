   function documentTypeOptions(entityType) {
     if (entityType === 'employee_license') {
       return [{value:'資格証・免許証', label:'資格証・免許証'}];
     }
+    if (entityType === 'employee_employment_contract') {
+      return [{value:'雇用・契約書類', label:'雇用・契約書類'}];
